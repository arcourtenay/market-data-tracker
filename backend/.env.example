# Required by SEC EDGAR fair-access rules: "<Company/App name> <contact email>"
SEC_USER_AGENT="Green Ash Partners adrian@greenash-partners.com"

# SQLite by default (zero setup, file-based, fine for local use).
# Swap for a Postgres URL when hosting, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/sec_tracker
DATABASE_URL="sqlite:///./sec_tracker.db"

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# Used to extract director/officer names from filing text (app.extract_people).
# Get a key at https://console.anthropic.com/ - required only for that script.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
